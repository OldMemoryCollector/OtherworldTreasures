  "OTHERWORLD_TREASURES_EVENT_GOLDEN_AXE.pages.INITIAL_SILVER.options.HONEST.title": "Be Honest",
  "OTHERWORLD_TREASURES_EVENT_GOLDEN_AXE.pages.INITIAL_SILVER.options.HONEST.description": "「普通のほうが私のです。」銀色のレリックを得る。",
