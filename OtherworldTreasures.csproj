<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ordinary builds are closed by default. Only the local development entry opts in. -->
    <OtherworldBuildFlavor Condition="'$(OtherworldBuildFlavor)' == ''">Release</OtherworldBuildFlavor>
    <OtherworldDevelopmentGroup Condition="'$(OtherworldDevelopmentGroup)' == ''">None</OtherworldDevelopmentGroup>
    <DefineConstants Condition="'$(OtherworldBuildFlavor)' == 'Development'">$(DefineConstants);OW_DEVELOPMENT</DefineConstants>
    <DefineConstants Condition="'$(OtherworldBuildFlavor)' == 'Development' And '$(OtherworldDevelopmentGroup)' == 'All'">$(DefineConstants);OW_DEV_ALL</DefineConstants>
    <DefineConstants Condition="'$(OtherworldBuildFlavor)' == 'Development' And '$(OtherworldDevelopmentGroup)' == 'Nine'">$(DefineConstants);OW_DEV_NINE</DefineConstants>
    <DefineConstants Condition="'$(OtherworldBuildFlavor)' == 'Development' And '$(OtherworldDevelopmentGroup)' == 'Spider'">$(DefineConstants);OW_DEV_SPIDER</DefineConstants>
    <DefineConstants Condition="'$(OtherworldBuildFlavor)' == 'Development' And '$(OtherworldDevelopmentGroup)' == 'Gintama'">$(DefineConstants);OW_DEV_GINTAMA</DefineConstants>
    <DefineConstants Condition="'$(OtherworldBuildFlavor)' == 'Development' And '$(OtherworldDevelopmentGroup)' == 'Extras'">$(DefineConstants);OW_DEV_EXTRAS</DefineConstants>
    <SkipModDeploy Condition="'$(SkipModDeploy)' == ''">true</SkipModDeploy>
    <RitsuLibAutoCopy Condition="'$(SkipModDeploy)' == 'true'">false</RitsuLibAutoCopy>

    <!-- 杀戮尖塔2安装目录 -->
    <Sts2Dir>F:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2ApiVersion Condition="'$(Sts2ApiVersion)' == ''">0.113.0</Sts2ApiVersion>
    <Sts2ReferenceRoot>$(MSBuildProjectDirectory)\..\塔2模组附属内容\02_参考资料\杀戮尖塔</Sts2ReferenceRoot>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2ReferenceRoot)\v$(Sts2ApiVersion)\程序集</Sts2DataDir>
    <DefineConstants Condition="'$(Sts2ApiVersion)' == '0.113.0'">$(DefineConstants);STS2_113</DefineConstants>
    <DefineConstants Condition="'$(Sts2ApiVersion)' == '0.111.0'">$(DefineConstants);STS2_111</DefineConstants>

    <!-- Godot 4.5.1 编辑器路径（与游戏版本一致） -->
    <GodotExe>F:\文件\工具\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64_console.exe</GodotExe>
    <ModPackScript Condition="'$(ModPackScript)' == ''">$(MSBuildProjectDirectory)\..\塔2模组附属内容\07_工程配套\工具\PackRuntime.gd</ModPackScript>
    <ModBuildOutput Condition="'$(ModBuildOutput)' == ''">$(MSBuildProjectDirectory)\..\塔2模组附属内容\05_测试导出\异次元乱入\artifacts\OtherworldTreasures</ModBuildOutput>

    <!-- RitsuLib自动部署目录 -->
    <RitsuLibDeployDir>$(Sts2Dir)\mods\STS2-RitsuLib\</RitsuLibDeployDir>
  </PropertyGroup>

  <!-- Debug 配置：不优化，便携式调试信息（热重载必需） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <!-- Release 配置：优化，无调试信息 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <!-- 把编译期源文件路径映射成相对路径，避免发布出去的 dll 里带上本机的绝对路径。
         原来的 $(AppOutputBase) 是 Csc 内部属性，在 MSBuild 求值时为空，
         会生成 "=.\" 这种非法 PathMap（CS8101），改用项目目录即可。 -->
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <!-- Resolve native overlay interfaces during Godot script indexing; release targets copy only this mod. -->
      <Private>true</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- RitsuLib NuGet包 -->
    <PackageReference Include="STS2.RitsuLib" Version="0.6.11" Condition="'$(Sts2ApiVersion)' == '0.113.0'" />
    <PackageReference Include="STS2.RitsuLib.Compat.0.111.0" Version="0.6.11" Condition="'$(Sts2ApiVersion)' == '0.111.0'" />
  </ItemGroup>

  <Target Name="ValidateOtherworldFlavor" BeforeTargets="BeforeBuild">
    <Error Condition="'$(OtherworldBuildFlavor)' != 'Release' And '$(OtherworldBuildFlavor)' != 'Development'" Text="Unknown OtherworldBuildFlavor." />
    <Error Condition="'$(OtherworldBuildFlavor)' == 'Release' And '$(OtherworldDevelopmentGroup)' != 'None'" Text="Release builds cannot enable development content." />
    <Error Condition="'$(OtherworldBuildFlavor)' == 'Development' And '$(OtherworldDevelopmentGroup)' != 'All' And '$(OtherworldDevelopmentGroup)' != 'Nine' And '$(OtherworldDevelopmentGroup)' != 'Spider' And '$(OtherworldDevelopmentGroup)' != 'Gintama' And '$(OtherworldDevelopmentGroup)' != 'Extras'" Text="Select a development group: All, Nine, Spider, Gintama, Extras." />
  </Target>

  <!-- 构建后自动复制dll、pdb、json到mods文件夹 -->
  <Target Name="Copy Mod" AfterTargets="PostBuildEvent" Condition="'$(SkipModDeploy)' != 'true'">
    <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(Sts2Dir)\mods\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
  </Target>

  <Target Name="ExportPck">
    <Error Condition="!Exists('$(ModPackScript)')" Text="External runtime pack tool is missing: $(ModPackScript)" />
    <MakeDir Directories="$(ModBuildOutput)" />
    <Exec Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --script &quot;$(ModPackScript)&quot; -- OtherworldTreasures &quot;$(ModBuildOutput)\$(MSBuildProjectName).pck&quot;" EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1" />
    <Copy SourceFiles="$(ModBuildOutput)\$(MSBuildProjectName).pck" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" Condition="'$(SkipModDeploy)' != 'true'" />
  </Target>
</Project>
